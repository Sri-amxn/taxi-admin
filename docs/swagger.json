        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success: {data: result, request_id: UUID}"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Admin role required"
          },
          "409": {
            "description": "Concurrent edit: reload current version"
          },
          "503": {
            "description": "Monitoring adapter not configured"
          }
        }
      }
    },
